# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit text file types
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pt binary
*.pth binary
*.onnx binary
*.bin binary
